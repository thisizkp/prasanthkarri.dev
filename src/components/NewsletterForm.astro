---
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME
const isConfigured = Boolean(username && !username.startsWith('your_'))
const action = isConfigured
  ? `https://buttondown.com/api/emails/embed-subscribe/${username}`
  : '#'
---

<aside aria-labelledby="newsletter-heading" class="newsletter">
  <div class="newsletter-inner">
    <h2 id="newsletter-heading">New writing, by email</h2>
    <p id="newsletter-description">Personal stories, things I'm learning, and questions worth taking time with. Get new posts in your inbox.</p>

    <form action={action} method="post" aria-describedby="newsletter-description">
      <input type="hidden" name="embed" value="1" />
      <div class="newsletter-field">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required disabled={!isConfigured} />
      </div>
      <button type="submit" disabled={!isConfigured}>
        Subscribe
      </button>
    </form>
  </div>
</aside>
